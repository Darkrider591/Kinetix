# Настройки интеграции Autodesk Inventor 2025 + LLM

# Провайдер по умолчанию: gemini или lm_studio
LLM_PROVIDER=gemini

# Google AI Studio (Gemini)
# Получить бесплатный ключ: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Модель Gemini по умолчанию (например gemini-2.5-flash или gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# LM Studio (Локальная модель)
# URL локального сервера LM Studio (по умолчанию http://localhost:1234/v1)
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=local-model

# Путь к папке чертежей (по умолчанию drawings)
DRAWINGS_DIR=drawings
